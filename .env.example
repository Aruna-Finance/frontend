# Copy to .env.local and adjust. Values prefixed NEXT_PUBLIC_ are inlined into the
# browser bundle at build time, so never put secrets here.

# RPC for Arbitrum Sepolia (chain ID 421614). Leave empty to use the public
# endpoint, which is fine for local development but rate-limited.
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# GraphQL endpoint for the Aruna indexer (Ponder). No production URL yet (hosting
# not chosen) — leave empty to use the local dev default (http://localhost:42069/graphql).
NEXT_PUBLIC_INDEXER_URL=
